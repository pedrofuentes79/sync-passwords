[Unit]
Description=RClone Google Drive Keepass Mount
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/rclone mount google_drive_keepass:Pedro/KeePass /home/pedrofuentes79/google_drive_keepass \
  --config=/home/pedrofuentes79/.config/rclone/rclone.conf \
  --vfs-cache-mode writes \
  --dir-cache-time 72h \
  --drive-chunk-size 32M \
  --vfs-read-chunk-size 128M \
  --vfs-read-chunk-size-limit off \
  --allow-non-empty
ExecStop=/bin/fusermount -u /home/pedrofuentes79/google_drive_keepass
Restart=on-failure
RestartSec=5
KillMode=process

[Install]
WantedBy=default.target
